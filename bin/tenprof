#!/bin/bash
#
# tenprof — standardized TenProf profiling driver.
# Modeled on DrGPUM/bin/gvprof, adapted for the newest HPCToolkit.
#
# Phases:
#   1. warmup  : hpcrun -e gpu=cuda            -> dumps GPU cubins
#   2. struct  : hpcstruct --gpucfg yes        -> disassembles cubins (+ CPU libs)
#   3. profile : one or more SEPARATE hpcrun runs (see -e below)
#   4. prof    : hpcprof                       -> database (tensor bridge: WIP)
#
# Events (GPA merge uses two SEPARATE runs that can't share a process):
#   torch_view  : compute-sanitizer + redshow  -> torch_view/{forest.txt,report.csv}
#   pc_sampling : NEW CUPTI PC-sampling (stalls)-> pc_sampling/pc_samples.csv
#   both        : run pc_sampling THEN torch_view into the same measurements dir
#   kernel_replay: SINGLE run -- per-kernel checkpoint replay does both PC sampling
#                  and the sanitizer in one process -> pc_samples.csv + torch_view
#
# Usage:
#   tenprof [options] <python-script> [script args]
#   options:
#     -e <event>     kernel_replay (default) | torch_view | pc_sampling | both
#     -attr <method> torch_view tensor<->access-pc attribution (default: gpu):
#                      gpu = on-GPU bitmap (fast); cpu = CPU memory-access trace
#                      (slower, more robust). Works for torch_view/both/kernel_replay.
#                      Shorthand for -ck HPCRUN_SANITIZER_TORCH_VIEW_ONGPU=1|0.
#     -j <threads>   hpcstruct/hpcprof threads (default: nproc)
#     -env <name>    conda env to activate (default: current active env)
#     -o <dir>       output prefix (default: tenprof). Produces <dir>-measurements
#                    and <dir>-database
#     -ck <knob>     extra control knob, e.g. -ck HPCRUN_SANITIZER_TORCH_VIEW_ONGPU=1
#                    (repeatable)
#     -l <launcher>  launcher prefix, e.g. -l "mpirun -np 1"
#     -no-warmup     skip the warmup+hpcstruct passes (analysis only)
#     -no-prof       skip the hpcprof phase (collection only; bridge is WIP)
#     -v             verbose: tee logs to tenprof.log instead of /dev/null
#     -h             help

set -o pipefail

usage() { sed -n '2,35'p "$0" | sed 's/^# \{0,1\}//'; exit 0; }

# ---------------------------------------------------------------------------
# Defaults / arg parsing
# ---------------------------------------------------------------------------
EVENT=kernel_replay
THREADS=$(nproc)
CONDA_ENV=""
OUT=tenprof
CONTROL_KNOBS=""
ATTR=gpu          # torch_view attribution: gpu (on-GPU bitmap) | cpu (CPU trace)
LAUNCHER=""
VERBOSE=0
DO_WARMUP=1
DO_PROF=1

while test "x$1" != x; do
  arg="$1"; shift
  case "$arg" in
    -e)   EVENT="$1"; shift ;;
    -j)   THREADS="$1"; shift ;;
    -env) CONDA_ENV="$1"; shift ;;
    -o)   OUT="$1"; shift ;;
    -ck)  CONTROL_KNOBS="$CONTROL_KNOBS -ck $1"; shift ;;
    -attr) ATTR="$1"; shift ;;
    -l)   LAUNCHER="$1"; shift ;;
    -no-warmup) DO_WARMUP=0 ;;
    -no-prof)   DO_PROF=0 ;;
    -v)   VERBOSE=1 ;;
    -h)   usage ;;
    *)    set -- "$arg" "$@"; break ;;
  esac
done

# Attribution method -> the on-GPU vs CPU torch_view knob. gpu = on-GPU bitmap
# (per-kernel pc<->tensor on the device; fast, default); cpu = CPU memory-access
# trace (transform_pc on the host; slower, more robust). Both produce joinable
# function-relative pcs and work for torch_view / both / kernel_replay. An explicit
# -ck HPCRUN_SANITIZER_TORCH_VIEW_ONGPU=... always wins over -attr.
case "$ATTR" in
  gpu|GPU|on_gpu|ongpu) ATTR_KNOB="-ck HPCRUN_SANITIZER_TORCH_VIEW_ONGPU=1" ;;
  cpu|CPU|on_cpu|oncpu) ATTR_KNOB="-ck HPCRUN_SANITIZER_TORCH_VIEW_ONGPU=0" ;;
  *) echo "tenprof: -attr must be 'gpu' or 'cpu' (got '$ATTR')"; exit 1 ;;
esac
case "$CONTROL_KNOBS" in
  *TORCH_VIEW_ONGPU*) ;;                                  # user set it via -ck; keep it
  *) CONTROL_KNOBS="$CONTROL_KNOBS $ATTR_KNOB" ;;
esac

# Which profiling pass(es) to run. `both` does the full GPA 2-run collection:
# the pc_sampling run (stalls) and the torch_view run (tensor accesses), into the
# same measurements dir, joined later by hpcprof.
case "$EVENT" in
  both) EVENTS="pc_sampling torch_view" ;;
  *)    EVENTS="$EVENT" ;;
esac

EXEC="$1"; shift
ARGS="$*"
if [ -z "$EXEC" ]; then echo "tenprof: no executable/script given"; exit 1; fi

MEAS="${OUT}-measurements"
DB="${OUT}-database"
if [ "$VERBOSE" = 1 ]; then REDIR=./tenprof.log; : > "$REDIR"; else REDIR=/dev/null; fi
log() { echo "==> $*"; }

# ---------------------------------------------------------------------------
# Locate the TenProf install
# ---------------------------------------------------------------------------
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
TENPROF_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
PREFIX="${TENPROF_PREFIX:-$TENPROF_ROOT/tenprof}"
HPCBIN="$PREFIX/hpctoolkit/bin"
CUDA_PATH="${CUDA_PATH:-/usr/local/cuda}"
SANITIZER_PATH="$CUDA_PATH/compute-sanitizer"

for t in hpcrun hpcstruct hpcprof; do
  [ -x "$HPCBIN/$t" ] || { echo "tenprof: $HPCBIN/$t not found (run bin/install first)"; exit 1; }
done

# ---------------------------------------------------------------------------
# Conda env (for PyTorch). Default: whatever is active.
# ---------------------------------------------------------------------------
CONDA_BASE=$(conda info --base 2>/dev/null || echo "$HOME/anaconda3")
# shellcheck disable=SC1091
source "$CONDA_BASE/etc/profile.d/conda.sh"
if [ -n "$CONDA_ENV" ]; then conda activate "$CONDA_ENV"; fi
TORCH_LIB=$(python -c 'import os,torch;print(os.path.dirname(torch.__file__)+"/lib")' 2>/dev/null)
PY_BIN=$(command -v python)

# ---------------------------------------------------------------------------
# Runtime library path. Imitates DrGPUM's gvprof launcher: export the FULL set
# of app/runtime lib dirs a real PyTorch model needs under hpcrun -- the active
# conda env's runtime (libgcc_s/libstdc++/libomp), torch + torchvision +
# torchaudio + the wheel-bundled NVIDIA libs (cudnn, cublas, ...), CUDA / CUPTI /
# compute-sanitizer, and the TenProf deps. (HPCTOOLKIT dlopen's libcupti;
# sanitizer dlopen's libsanitizer-public; libredshow/libtorch_monitor are rpath'd
# into libhpcrun; hpcprof needs HPCToolkit's own libdw/libelf/dyninst.)
# ---------------------------------------------------------------------------
export PATH="$HPCBIN:$CUDA_PATH/bin:$PATH"
HPCLIB="$PREFIX/hpctoolkit/lib/x86_64-linux-gnu"
CONDA_LIB="${CONDA_PREFIX:+$CONDA_PREFIX/lib}"
# torchvision / torchaudio lib dirs + the torch-bundled NVIDIA *.so dirs (cudnn,
# cublas, nccl, ...), present only when installed.
EXTRA_TORCH_LIBS=$(python - <<'PY' 2>/dev/null
import os, glob
dirs = []
for mod in ("torchvision", "torchaudio"):
    try: dirs.append(os.path.dirname(__import__(mod).__file__) + "/lib")
    except Exception: pass
try:
    import torch
    dirs += glob.glob(os.path.dirname(torch.__file__) + "/../nvidia/*/lib")
except Exception: pass
print(":".join(d for d in dirs if os.path.isdir(d)))
PY
)
export LD_LIBRARY_PATH="$HPCLIB:$CUDA_PATH/extras/CUPTI/lib64:$SANITIZER_PATH:$CUDA_PATH/lib64:$PREFIX/../torch-monitor/usr/local/lib:$PREFIX/../redshow/lib:${EXTRA_TORCH_LIBS:+$EXTRA_TORCH_LIBS:}${TORCH_LIB:+$TORCH_LIB:}${CONDA_LIB:+$CONDA_LIB:}$LD_LIBRARY_PATH"

# hpctoolkit's bundled libunwind.so (on HPCLIB above) exports the C++ _Unwind_*
# ABI; with HPCLIB on the search path, libstdc++'s exception personality can bind
# its unwinder to hpctoolkit's libunwind instead of libgcc_s and CRASH while
# unwinding a normal C++ exception thrown inside the profiled app (e.g. any torch
# op that raises -> converts to a Python error). Preload libgcc_s so the C++
# _Unwind_* symbols resolve to the correct provider regardless of search order;
# exception handling in the profiled application then works normally under hpcrun.
GCCS="$(gcc -print-file-name=libgcc_s.so.1 2>/dev/null)"
[ -e "$GCCS" ] || GCCS=/lib/x86_64-linux-gnu/libgcc_s.so.1
[ -e "$GCCS" ] && export LD_PRELOAD="$GCCS${LD_PRELOAD:+:$LD_PRELOAD}"

log "TenProf install : $PREFIX"
log "conda env       : ${CONDA_ENV:-$(basename "${CONDA_PREFIX:-?}")}  (python=$PY_BIN)"
log "event           : $EVENT   threads=$THREADS"
log "attribution     : $ATTR  (torch_view tensor<->pc: $([ "$ATTR" = cpu ] && echo 'CPU trace' || echo 'on-GPU bitmap'))"
log "measurements    : $MEAS    database=$DB"

# Always wipe the database. Wipe measurements ONLY when (re)warming: warmup cubins +
# hpcstruct are deterministic for the same app/env, so -no-warmup reuses an existing
# $MEAS (cubins/gpubins/structs) and just re-runs the profiling pass into it. (Without
# this guard -no-warmup wiped the very cubins it needs.) Profiling output subdirs
# (torch_view/, pc_sampling/) are cleared below so a reused $MEAS starts clean.
rm -rf "$DB"
if [ "$DO_WARMUP" = 1 ]; then
  rm -rf "$MEAS"
else
  rm -rf "$MEAS/torch_view" "$MEAS/pc_sampling" "$MEAS/cfg" \
         "$MEAS"/tensor_stall_cost.csv "$MEAS"/blame.dot "$MEAS"/blame.dot.svg \
         "$MEAS"/*.hpcrun "$MEAS"/*.log 2>/dev/null
fi

# ---------------------------------------------------------------------------
# hpcstruct helper for CPU support libraries (best-effort; skip if missing)
# ---------------------------------------------------------------------------
struct_lib() { [ -e "$1" ] && hpcstruct -j "$THREADS" "$1" >>"$REDIR" 2>&1 || true; }

if [ "$DO_WARMUP" = 1 ]; then
  # -------------------------------------------------------------------------
  # Phase 1: warmup — dump GPU cubins via CUPTI (no sanitizer, fast)
  # -------------------------------------------------------------------------
  log "[1/4] warmup: dumping cubins (gpu=cuda)"
  $LAUNCHER hpcrun -e gpu=cuda -o "$MEAS" "$PY_BIN" "$EXEC" $ARGS >"$REDIR" 2>&1

  # -------------------------------------------------------------------------
  # Phase 2: hpcstruct. NOTE: the new hpcstruct needs the warmup .hpcrun files
  # present to discover the measurement, so struct FIRST, then drop them.
  # -------------------------------------------------------------------------
  log "[2/4] hpcstruct --gpucfg yes (cubins + CPU libs)"
  hpcstruct --gpucfg yes -j "$THREADS" "$MEAS" >>"$REDIR" 2>&1
  if [ -d "$MEAS/structs" ]; then
    ( cd "$MEAS/structs"
      struct_lib "$PY_BIN"
      struct_lib "$PREFIX/hpctoolkit/lib/x86_64-linux-gnu/libhpcrun.so"
      struct_lib /usr/lib/x86_64-linux-gnu/libcuda.so
      struct_lib "$CUDA_PATH/extras/CUPTI/lib64/libcupti.so"
      struct_lib "$SANITIZER_PATH/libsanitizer-public.so"
      for so in libtorch_cuda.so libc10_cuda.so libtorch_python.so; do
        struct_lib "$TORCH_LIB/$so"
      done
      # drop struct files that only produced warnings (no usable structure)
      for w in ./*.warnings; do [ -e "$w" ] && rm -f "${w%.warnings}.hpcstruct"; done
    )
  fi
  # keep cubins + structs, drop warmup profile so the torch_view pass owns it
  rm -f "$MEAS"/*.hpcrun "$MEAS"/*.log
fi

# ---------------------------------------------------------------------------
# Phase 3: profiling pass(es).
#   kernel_replay : ONE run. Per-kernel checkpoint replay does the sanitizer
#                   (tensor accesses) AND PC sampling (memory stalls) in a single
#                   process, joined by (kernel_id, pc). This is the GPA+DrGPUM
#                   merge in one pass — preferred.
#   both          : the older 2-run fallback (pc_sampling then torch_view). These
#                   are SEPARATE runs that cannot share a process (the CUPTI
#                   profiler and the compute-sanitizer are mutually exclusive),
#                   joined later by hpcprof on (pystates_hash, pc).
# Each writes into $MEAS.
# ---------------------------------------------------------------------------
for ev in $EVENTS; do
  log "[3/5] profiling (gpu=cuda,$ev)"
  $LAUNCHER hpcrun -e "gpu=cuda,$ev" -o "$MEAS" $CONTROL_KNOBS \
    "$PY_BIN" "$EXEC" $ARGS >"$REDIR" 2>&1
done

# ---------------------------------------------------------------------------
# Phase 4: blame-shift -> Tensor Stall Cost. tensor_blame reads pc_samples.csv +
# torch_view, disassembles the cubins (GPA lib/cuda), blame-shifts memory stalls
# to their producing loads, and joins on (pystates_hash, pc) -> tensor_stall_cost
# .csv + blame.dot (graphviz).
#
# The join key is (pystates_hash, pc) -- content-based and IDENTICAL across
# processes (both runs hash the same Python call stack with the same std::hash),
# so it works for BOTH modes:
#   kernel_replay : one process; pc_samples.csv + torch_view are from the same run.
#   both          : application replay -- the SEPARATE pc_sampling and torch_view
#                   runs each stamp pystates_hash, so the cross-process join holds
#                   (kernel_id would NOT match across processes; pystates_hash does).
# Run whenever both inputs are present (skips pc_sampling-only / torch_view-only).
# ---------------------------------------------------------------------------
if [ -f "$MEAS/pc_sampling/pc_samples.csv" ] && [ -f "$MEAS/torch_view/torch_view_report.csv" ]; then
  TB="$HPCBIN/tensor_blame"
  [ -x "$TB" ] || TB="$(command -v tensor_blame 2>/dev/null)"
  if [ -x "$TB" ]; then
    log "[4/5] tensor_blame -> tensor_stall_cost.csv + blame.dot"
    TB_THREADS="$THREADS" "$TB" "$MEAS/gpubins" "$MEAS" >>"$REDIR" 2>&1
    # Render the tensor transformation forest (TenProf paper Figure 7) with plain
    # graphviz -- all styling (ellipses, solid/dashed outlines+edges, size, color,
    # tooltips) is emitted in blame.dot, so `dot` alone produces the final SVG.
    DOT="$(command -v dot 2>/dev/null)"
    [ -n "$DOT" ] || DOT="$CONDA_BASE/envs/gviz/bin/dot"
    if [ -f "$MEAS/blame.dot" ] && [ -x "$DOT" ]; then
      if "$DOT" -Tsvg "$MEAS/blame.dot" -o "$MEAS/blame.dot.svg" >>"$REDIR" 2>&1; then
        log "      dot -> blame.dot.svg"
      else
        log "      dot render skipped (install graphviz; blame.dot ready for manual render)"
      fi
    fi
  else
    log "[4/5] tensor_blame not found (build/install it: meson install -C hpctoolkit/builddir)"
  fi
fi

# ---------------------------------------------------------------------------
# Phase 5: hpcprof — build the database. Skipped with -no-prof.
# ---------------------------------------------------------------------------
if [ "$DO_PROF" = 1 ]; then
  log "[5/5] hpcprof -> $DB"
  hpcprof -o "$DB" "$MEAS" >>"$REDIR" 2>&1
else
  log "[5/5] hpcprof skipped (-no-prof)"
fi

log "done."
[ -f "$MEAS/pc_sampling/pc_samples.csv" ] && \
  echo "    pc-sampling stalls: $MEAS/pc_sampling/pc_samples.csv"
[ -d "$MEAS/torch_view" ] && echo "    torch_view output : $MEAS/torch_view/{forest.txt,torch_view_report.csv}"
[ -f "$MEAS/tensor_stall_cost.csv" ] && \
  echo "    tensor stall cost : $MEAS/tensor_stall_cost.csv"
[ -f "$MEAS/blame.dot" ] && \
  echo "    blame forest (dot): $MEAS/blame.dot   (dot -Tsvg ... -o ....svg)"
[ -f "$MEAS/blame.dot.svg" ] && \
  echo "    blame forest (svg): $MEAS/blame.dot.svg"
[ "$DO_PROF" = 1 ] && echo "    database          : $DB"
